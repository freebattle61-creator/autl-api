# Node.js 24. Copy only into a private deployment environment; never commit secrets.
NODE_ENV="production"
HOST="127.0.0.1"
PORT="8317"
# Use an actual private persistent volume on the approved host.
LICENSE_DB_FILE="/private-persistent-volume/license.sqlite"
SESSION_TTL_SECONDS="3600"
# Required only when initializing a new empty database. Replace this placeholder.
ADMIN_USERNAME="your-admin"
ADMIN_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_PRIVATE_PASSWORD"

# Optional Firebase mode: leaving URL unset selects SQLite.
# A nonempty unrevisioned Firebase database is NOT silently migrated/adopted.
# FIREBASE_DATABASE_URL="https://YOUR-PROJECT-default-rtdb.firebaseio.com"
# FIREBASE_DATABASE_PATH="/license_api"
# Choose one private credential method; never put keys in src/ or public assets.
# GOOGLE_APPLICATION_CREDENTIALS="/private/firebase-service-account.json"
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# FIREBASE_SERVICE_ACCOUNT_BASE64="..."
# On Google Cloud an authorized attached service account can use ADC.

# Set HOST=0.0.0.0 only when the approved hosting/reverse-proxy setup requires it.
