{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --packages=external --bundle --outfile=server.js",
    "start": "NODE_ENV=production node server.js",
    "test": "tsx test.ts",
    "clean": "rm -rf dist server.js database.json",
    "lint": "tsc --noEmit",
    "test:startup": "tsx startup.test.ts",
    "test:firebase-safety": "tsx firebase-safety.test.ts",
    "test:maintenance": "tsx maintenance.test.ts",
    "test:products": "tsx products.test.ts",
    "test:diagnostics": "tsx diagnostics.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
